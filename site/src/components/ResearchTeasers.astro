---
import { currentResearch } from '../data/currentResearch';
---
<div class="research-grid">
  {currentResearch.map((project) => (
    <article class:list={['research-card', `research-${project.id}`, 'reveal']} id={project.id}>
      <div class="research-visual">
        {project.media ? <video src={`/research/previews/${project.media}.mp4`} poster={`/research/previews/${project.media}.jpg`} autoplay muted loop playsinline controls preload="metadata" aria-label={project.alt} /> :
          <div class="agent-art" role="img" aria-label="An abstract illustration of collaborating agents">
            <svg viewBox="0 0 600 340" aria-hidden="true">
              <g class="orbit-lines" fill="none" stroke="currentColor" stroke-width="1"><ellipse cx="300" cy="170" rx="214" ry="104" transform="rotate(-22 300 170)"/><ellipse cx="300" cy="170" rx="176" ry="64" transform="rotate(26 300 170)"/><path d="M128 235L300 170L456 94M180 84L300 170L415 250"/></g>
              <g class="agent-node"><rect x="265" y="135" width="70" height="70" rx="20" transform="rotate(-12 300 170)"/><path d="M285 170h30m-15-15v30"/></g>
              <g class="satellite"><rect x="108" y="215" width="40" height="40" rx="12"/><rect x="160" y="64" width="40" height="40" rx="12"/><rect x="436" y="74" width="40" height="40" rx="12"/><rect x="395" y="230" width="40" height="40" rx="12"/></g>
              <g class="satellite-eyes"><path d="M120 231v7m15-7v7M172 80v7m15-7v7M448 90v7m15-7v7M407 246v7m15-7v7"/></g>
            </svg>
          </div>}
        {project.media && <button class="preview-toggle" type="button" aria-label={`Pause ${project.title} preview`} aria-pressed="false" hidden>Pause</button>}
      </div>
      <div class="research-copy"><span class="research-status">{project.status}</span><h3>{project.title}</h3><p class="coming-soon">Details / Paper Coming Soon</p><a class="overview-link" href={`/research/overview${project.media ? `#${project.media}` : ''}`} data-astro-reload>Private overview ↗</a></div>
    </article>
  ))}
</div>
<style>
  .research-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem; }
  .research-card { min-width:0; scroll-margin-top:7rem; border:1px solid var(--border); border-radius:1rem; background:var(--surface); overflow:hidden; }
  .research-visual { position:relative; overflow:hidden; aspect-ratio:1.65; background:#282e28; }
  video,.agent-art { display:block; width:100%; height:100%; object-fit:cover; }
  video { transition:transform .8s var(--ease); }
  .research-card:hover video { transform:scale(1.025); }
  .research-hsr-vla video { object-fit:cover; }
  .research-humanoid-soccer video { object-fit:contain; background:#264526; }
  .research-copy { padding:1.5rem; }
  .research-status { display:inline-block; color:var(--accent); font-size:.75rem; margin-bottom:.75rem; }
  h3 { font-family:var(--font-sans); font-size:clamp(1.25rem,2vw,1.65rem); font-weight:500; letter-spacing:-.035em; line-height:1.3; }
  .coming-soon { padding-top:.75rem; color:var(--muted); font-size:.8rem; }
  .overview-link { display:inline-flex; margin-top:1rem; color:var(--accent); font-size:.8rem; }
  .preview-toggle { position:absolute; bottom:.8rem; right:.8rem; min-height:36px; border:1px solid #ffffff28; border-radius:999px; font-size:.7rem; background:#181918dd; color:#eeeee7; padding:.4rem .8rem; cursor:pointer; }
  .preview-toggle:hover { background:var(--bg); }
  .agent-art { position:relative; background:#242b24; color:#9aaf8a; display:grid; place-items:center; }
  .agent-art svg { width:94%; height:94%; }
  .orbit-lines { opacity:.35; }
  .agent-node rect { fill:#bddc92; }.agent-node path { stroke:#242b24; stroke-width:2; }
  .satellite { fill:#323d32; stroke:#7d9072; stroke-width:1; }.satellite-eyes { stroke:#c9dbbb; stroke-width:2; }
  @media(max-width:640px) { .research-grid { grid-template-columns:1fr; gap:1.5rem; }.research-copy { padding:1.25rem; } }
</style>
<script>
  import { initializeResearchVideos } from '../lib/researchVideos';
  let stopPreviews: (() => void) | undefined;
  const init = () => { stopPreviews?.(); stopPreviews = initializeResearchVideos(); };
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => stopPreviews?.());
  window.addEventListener('pageshow', event => { if(event.persisted) init(); });
</script>
