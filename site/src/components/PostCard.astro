---
import { formatDate, formatMonth, type Post } from '../lib/posts';

interface Props {
  post: Post;
  delay?: number;
}

const { post, delay = 0 } = Astro.props;
const isNote = post.kind === 'note';
const stamp = post.updated ?? post.date;
---

<article class="card post-card reveal" style={`--reveal-delay:${delay}s`}>
  <p class="post-date">
    {isNote && <span class:list={['kind', post.wip && 'wip']}>{post.wip ? 'in progress' : 'note'}</span>}
    {isNote && <span class="dot">/</span>}
    <time datetime={stamp.toISOString()}>
      {isNote ? `updated ${formatMonth(stamp)}` : formatDate(post.date)}
    </time>
    <span class="dot">/</span>
    <span>{post.minutes} min</span>
  </p>
  <h3 class="post-title">
    <a href={`/blog/${post.slug}`}>{post.title}</a>
  </h3>
  {post.description && <p class="post-desc">{post.description}</p>}
  {post.tags.length > 0 && (
    <div class="chip-row">
      {post.tags.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  )}
</article>

<style>
  /* fills the grid slot so every card in a row ends on the same line */
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--faint);
    letter-spacing: 0.02em;
  }

  /* keep "1 min" and "Jul 2026" from splitting across lines */
  .post-date > * {
    white-space: nowrap;
  }

  .dot {
    margin-inline: 0.35rem;
  }

  .kind {
    color: var(--accent);
  }

  .kind.wip {
    color: var(--accent-2);
  }

  .post-title {
    font-size: 1.14rem;
    line-height: 1.32;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-title a {
    color: var(--text);
  }

  /* stretched link — whole card is clickable */
  .post-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .post-card:hover .post-title a {
    color: var(--accent);
  }

  .post-desc {
    color: var(--muted);
    font-size: 0.91rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* tags sit on the card floor, so they line up across a row */
  .chip-row {
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
