---
import PubFigure from './PubFigure.astro';
import { ME, type Publication } from '../data/publications';

interface Props {
  pub: Publication;
  flip?: boolean;
}

const { pub, flip = false } = Astro.props;
const hasFigure = Boolean(pub.figure || pub.sequence);
---

<article class:list={['pub', { flip, 'no-fig': !hasFigure }]} id={pub.id}>
  {hasFigure && (
    <div class="pub-fig reveal">
      <PubFigure pub={pub} />
    </div>
  )}

  <div class="pub-body reveal" style="--reveal-delay: 0.08s">
    <p class="pub-venue">
      <span class="venue-badge">{pub.venueShort}</span>
      <span class="pub-year">{pub.year}</span>
    </p>
    <h3 class="pub-title">{pub.title}</h3>
    <p class="pub-authors">
      {pub.authors.map((a, i) => (
        <>
          <span class:list={{ me: a === ME }}>{a}</span>{i < pub.authors.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>
    <p class="pub-summary">{pub.summary}</p>
    {pub.note && <p class="pub-note">✦ {pub.note}</p>}
    <p class="pub-links">
      {pub.links.map((l) => (
        <a class="pub-link" href={l.url} target="_blank" rel="noopener">
          {l.label} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </p>
    <div class="chip-row">
      {pub.tags.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  </div>
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .pub.flip {
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
  }

  .pub.flip .pub-fig {
    order: 2;
  }

  .pub.no-fig {
    grid-template-columns: minmax(0, 1fr);
    border-left: 2px solid var(--hairline);
    padding-left: clamp(1rem, 3vw, 2rem);
  }

  .pub-venue {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 0.8rem;
  }

  .pub-year {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--faint);
  }

  .pub-title {
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    margin-bottom: 0.55rem;
  }

  .pub-authors {
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }

  .pub-authors .me {
    color: var(--text);
    font-weight: 600;
  }

  .pub-summary {
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.7;
    margin-bottom: 0.9rem;
  }

  .pub-note {
    font-size: 0.84rem;
    color: var(--accent-2);
    margin-bottom: 0.9rem;
  }

  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }

  .pub-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.28rem 0.8rem;
    color: var(--text);
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .pub-link:hover {
    border-color: var(--accent);
    background: var(--accent-dim);
    transform: translateY(-1px);
  }

  .pub-link span {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .pub,
    .pub.flip {
      grid-template-columns: minmax(0, 1fr);
    }

    .pub.flip .pub-fig {
      order: 0;
    }
  }
</style>
