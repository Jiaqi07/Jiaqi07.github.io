---
const path = Astro.url.pathname;
const links = [{href:'/research',label:'Research'},{href:'/blog',label:'Writing'},{href:'/about',label:'About'}];
const active = (href: string) => path === href || path.startsWith(href+'/');
---
<header class="site-nav">
  <a href="/" class="brand" aria-label="Alan Chen, home"><img src="/mudkip.ico" alt="Mudkip" width="32" height="32" /></a>
  <nav class="desktop-links" aria-label="Primary">{links.map(link=><a href={link.href} aria-current={active(link.href) ? 'page':undefined}>{link.label}</a>)}</nav>
  <a class="nav-contact" href="mailto:alanjiach@gmail.com">Say hello <span aria-hidden="true">↗</span></a>
  <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" type="button"><span></span><span></span></button>
</header>
<dialog id="mobile-menu" aria-label="Navigation menu">
  <button class="menu-close" aria-label="Close menu" type="button"><span></span><span></span></button>
  <nav aria-label="Mobile">{[{href:'/',label:'Home'},...links].map((link,i)=><a href={link.href} style={`--i:${i}`} aria-current={(link.href==='/'?path==='/':active(link.href))?'page':undefined}><span>0{i+1}</span>{link.label} ↗</a>)}</nav>
  <a class="menu-email" href="mailto:alanjiach@gmail.com">alanjiach@gmail.com</a>
</dialog>
<style>
.site-nav { position:fixed; top:1.5rem; left:50%; transform:translateX(-50%); z-index:50; display:flex; align-items:center; gap:2rem; padding:.5rem .5rem .5rem 1.5rem; border:1px solid var(--border); border-radius:999px; background:#202320ed; backdrop-filter:blur(24px); box-shadow:0 8px 32px #00000025; width:max-content; max-width:calc(100% - 3rem); }
.brand { font-size:1.5rem; line-height:2rem; color:var(--text); font-weight:700; letter-spacing:-.08em; display:flex; align-items:center; }
.brand span { color:var(--accent); font-family:var(--font-sans); font-size:.9rem; margin-left:.2rem; }
.brand img { display:block;width:32px;height:32px;object-fit:contain; }
.desktop-links { display:flex; gap:1.5rem; align-items:center; }
.desktop-links a { font-size:.875rem; line-height:1.25rem; color:var(--muted); padding:.75rem 0; }
.desktop-links a:hover,.desktop-links a[aria-current] { color:var(--accent); }
.nav-contact { background:var(--accent); color:var(--bg); font-size:.875rem; line-height:1.25rem; font-weight:600; padding:.75rem 1rem; border-radius:999px; display:flex; gap:1rem; }
.nav-contact:hover { background:var(--accent-strong); color:var(--bg); }
.menu-toggle,.menu-close { position:relative; width:3rem; height:3rem; border:1px solid var(--border); border-radius:50%; background:var(--surface); color:var(--text); cursor:pointer; }
.menu-toggle { display:none; }
.menu-toggle span,.menu-close span { width:1rem; height:2px; background:currentColor; position:absolute; left:calc(50% - .5rem); top:50%; transition:transform .7s var(--ease); }
.menu-toggle span:first-child { transform:translateY(-4px); }.menu-toggle span:last-child { transform:translateY(4px); }
.menu-toggle[aria-expanded='true'] span:first-child,.menu-close span:first-child { transform:rotate(45deg); }.menu-toggle[aria-expanded='true'] span:last-child,.menu-close span:last-child { transform:rotate(-45deg); }
dialog { position:fixed; inset:0; width:100%; height:100dvh; max-width:none; max-height:none; margin:0; padding:6rem 2rem 3rem; border:0; background:#181918f5; backdrop-filter:blur(48px); color:var(--text); }
dialog::backdrop { background:#00000080; }
.menu-close { position:absolute; right:1.5rem; top:1.5rem; }
dialog nav { display:flex; flex-direction:column; gap:1.5rem; } dialog nav a { color:var(--text); font-size:3rem; line-height:1; letter-spacing:-.05em; }
dialog nav a span { color:var(--accent); font-size:.75rem; letter-spacing:0; margin-right:1rem; }
dialog[open] nav a { animation:menu-in .8s var(--ease) both; animation-delay:calc(var(--i) * 80ms); }
dialog nav a[aria-current],dialog nav a:hover { color:var(--accent); }
.menu-email { display:inline-block; margin-top:3rem; font-size:.875rem; }
@keyframes menu-in { from { opacity:0; transform:translateY(48px); } to { opacity:1; transform:none; } }
@media(max-width:600px) { .site-nav { width:calc(100% - 2rem); max-width:none; top:1rem; padding:.4rem .4rem .4rem 1.25rem; justify-content:space-between; gap:1rem; } .desktop-links { display:none; }.menu-toggle { display:block; }.nav-contact { margin-left:auto; } }
@media(max-width:380px) { dialog nav a { font-size:2.25rem; line-height:2.5rem; } }
</style>
<script>
  let navAbort: AbortController | undefined;
  document.addEventListener('astro:before-swap',()=>{navAbort?.abort(); document.body.style.overflow='';});
  document.addEventListener('astro:page-load',()=>{
    navAbort?.abort(); navAbort=new AbortController();const signal=navAbort.signal;
    const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');
    const modal=document.querySelector<HTMLDialogElement>('#mobile-menu');
    if(!toggle || !modal) return;
    const close=()=>{modal.close();toggle.setAttribute('aria-expanded','false');document.body.style.overflow='';};
    toggle.addEventListener('click',()=>{modal.showModal();toggle.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';},{signal});
    modal.querySelector('.menu-close')?.addEventListener('click',close,{signal});
    modal.addEventListener('close',()=>{toggle.setAttribute('aria-expanded','false');document.body.style.overflow='';},{signal});
    modal.querySelectorAll('a').forEach(a=>a.addEventListener('click',close,{signal}));
  });
</script>
