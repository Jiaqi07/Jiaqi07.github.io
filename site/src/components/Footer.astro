---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
const socials = [
  { href: profile.links.scholar, label: 'Google Scholar', icon: 'scholar' },
  { href: profile.links.github, label: 'GitHub', icon: 'github' },
  { href: profile.links.x, label: 'X / Twitter', icon: 'x' },
  { href: profile.links.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { href: `mailto:${profile.email}`, label: 'Email', icon: 'mail' },
  { href: '/rss.xml', label: 'RSS', icon: 'rss' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-social">
      {socials.map((s) => (
        <a href={s.href} aria-label={s.label} title={s.label} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener' : undefined}>
          {s.icon === 'scholar' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 1 8l11 6 9-4.91V17h2V8L12 2zm-7 9.82v4.36c0 1.55 3.13 3.32 7 3.32s7-1.77 7-3.32v-4.36l-7 3.82-7-3.82z"/></svg>
          )}
          {s.icon === 'github' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.26 5.67.41.36.78 1.06.78 2.14 0 1.55-.02 2.79-.02 3.17 0 .31.21.68.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          )}
          {s.icon === 'x' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41z"/></svg>
          )}
          {s.icon === 'linkedin' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
          )}
          {s.icon === 'mail' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6L22 7"/></svg>
          )}
          {s.icon === 'rss' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 17.82a2.18 2.18 0 1 1-4.36 0 2.18 2.18 0 0 1 4.36 0zM1.82 8.73v3.27c5.62 0 10.18 4.56 10.18 10.18h3.27c0-7.43-6.02-13.45-13.45-13.45zM1.82 2.18v3.27c10.14 0 18.37 8.23 18.37 18.37h3.27C23.45 11.87 13.76 2.18 1.82 2.18z"/></svg>
          )}
        </a>
      ))}
    </div>

    <p class="footer-line">
      © {year} Alan Chen · Austin, TX
    </p>

    <p class="footer-origin">
      <img src="/images/scratch-avatar.png" alt="Alan's childhood Scratch avatar" width="20" height="20" loading="lazy" />
      <span>been shipping since the <a href="https://scratch.mit.edu/users/ac91305/" target="_blank" rel="noopener">Scratch days</a></span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    padding: 2.6rem 0 3rem;
    margin-top: 4rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    text-align: center;
  }

  .footer-social {
    display: flex;
    gap: 1.1rem;
  }

  .footer-social a {
    color: var(--muted);
    display: inline-grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .footer-social a:hover {
    color: var(--accent);
    border-color: var(--border);
    transform: translateY(-2px);
  }

  .footer-line {
    color: var(--faint);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  .footer-origin {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--faint);
    font-size: 0.82rem;
  }

  .footer-origin img {
    border-radius: 5px;
    image-rendering: pixelated;
  }

  .footer-origin a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-origin a:hover {
    color: var(--accent);
  }
</style>
