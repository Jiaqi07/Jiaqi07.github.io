---
import { profile } from '../data/profile';
const socials = [{name:'Google Scholar',url:profile.links.scholar},{name:'GitHub',url:profile.links.github},{name:'LinkedIn',url:profile.links.linkedin},{name:'X',url:profile.links.x}];
---
<footer class="studio-footer">
  <div class="footer-top"><a href="/" class="footer-signature" aria-label="Alan Chen, home">Alan Chen</a><nav aria-label="Social links">{socials.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.name} ↗</a>)}</nav></div>
  <div class="footer-bottom"><p>© {new Date().getFullYear()} Alan Chen / Austin, TX</p><p>Curiosity is a work in progress.</p><a href="/rss.xml">RSS ↗</a></div>
</footer>
<style>
.studio-footer { width:min(calc(100% - 6rem),80rem); margin:0 auto; padding:3rem 0 2rem; border-top:1px solid var(--border); }
.footer-top,.footer-bottom { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; }
.footer-signature { display:flex; align-items:center; gap:1rem; font-size:2.25rem; line-height:2.5rem; font-family:var(--font-sans); font-weight:500; letter-spacing:-.05em; color:var(--text); }.footer-signature span { color:var(--accent); }
nav { display:flex; flex-wrap:wrap; gap:1.5rem; }nav a { color:var(--text);font-size:.875rem;line-height:1.25rem; }nav a:hover { color:var(--accent); }
.footer-bottom { margin-top:3rem; font-size:.75rem;line-height:1rem;color:var(--muted); }.footer-bottom a { color:var(--muted); }
@media(max-width:760px) { .studio-footer { width:calc(100% - 3rem); }.footer-top,.footer-bottom { align-items:flex-start;flex-direction:column; }.footer-bottom { gap:1rem; } }
</style>
