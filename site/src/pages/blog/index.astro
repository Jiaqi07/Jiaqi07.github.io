---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, essays, groupByArea } from '../../lib/posts';

const posts = await getPosts();
const written = essays(posts);
const noteGroups = groupByArea(posts);
const tags = [...new Set(posts.flatMap((p) => p.tags))].sort();
const noteCount = noteGroups.reduce((n, g) => n + g.posts.length, 0);
---

<Base
  title="Writing"
  description="Essays and working notes by Alan Chen: robot learning, reinforcement learning, transformers, diffusion, and the math underneath all of it."
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow reveal in-view">writing</p>
      <h1 class="page-title reveal in-view">Notes &amp; writeups</h1>
      <p class="page-sub reveal in-view">
        Two kinds of thing live here. Essays are finished. Notes are the reference pile — derivations
        I redo too often, paper writeups from reading group, and fields I only half understand — and
        they get edited in place rather than finished, so expect loose ends. Written in Obsidian,
        published by a git push.
      </p>

      {tags.length > 0 && (
        <div class="filter-row reveal in-view" id="tag-filter" role="group" aria-label="Filter by tag">
          <button class="filter-chip active" data-tag="">all</button>
          {tags.map((t) => (
            <button class="filter-chip" data-tag={t}>{t}</button>
          ))}
        </div>
      )}
    </div>
  </section>

  <div class="feed" id="feed">
    {written.length > 0 && (
      <section class="block" data-group>
        <div class="container">
          <header class="block-head reveal">
            <h2 class="block-title">Essays</h2>
            <p class="block-blurb">Longer-form thinking, and the pieces I actually finished.</p>
          </header>
          <div class="posts-grid">
            {written.map((post, i) => (
              <div class="post-slot" data-tags={post.tags.join('|')}>
                <PostCard post={post} delay={Math.min(i, 5) * 0.06} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {noteCount > 0 && (
      <section class="block notes-block">
        <div class="container">
          <header class="block-head reveal">
            <h2 class="block-title">Notes</h2>
            <p class="block-blurb">
              {noteCount} of them, filed by how far down the stack they sit.
            </p>
          </header>

          {noteGroups.map((group) => (
            <section class="area" data-group>
              <h3 class="area-title reveal">{group.label}</h3>
              <p class="area-blurb reveal">{group.blurb}</p>
              <div class="posts-grid">
                {group.posts.map((post, i) => (
                  <div class="post-slot" data-tags={post.tags.join('|')}>
                    <PostCard post={post} delay={Math.min(i, 5) * 0.06} />
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    )}

    <p class="empty container" id="empty" hidden>Nothing tagged that way yet.</p>
  </div>
</Base>

<style>
  .page-head {
    padding-top: clamp(7rem, 16vh, 10rem);
    padding-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .page-title {
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    letter-spacing: -0.025em;
    margin-bottom: 0.9rem;
  }

  .page-sub {
    color: var(--muted);
    max-width: 42rem;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.6rem;
  }

  .filter-chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .filter-chip:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .filter-chip.active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .feed {
    padding-block: 2rem 3.5rem;
  }

  .block + .block {
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  .block-head {
    margin-bottom: 1.5rem;
  }

  .block-title {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    margin-bottom: 0.35rem;
  }

  .block-blurb {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 42rem;
  }

  .area {
    border-top: 1px solid var(--hairline);
    padding-top: 1.2rem;
    margin-top: 2rem;
  }

  .area-title {
    font-size: 1.22rem;
    margin-bottom: 0.3rem;
  }

  .area-blurb {
    color: var(--muted);
    font-size: 0.92rem;
    max-width: 42rem;
    margin-bottom: 1.2rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .post-slot.hidden,
  [data-group].hidden,
  .notes-block.hidden {
    display: none;
  }

  .empty {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  @media (max-width: 1000px) {
    .posts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  function initFilter() {
    const bar = document.getElementById('tag-filter');
    const feed = document.getElementById('feed');
    const empty = document.getElementById('empty');
    if (!bar || !feed) return;

    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-chip');
      if (!btn) return;
      bar.querySelectorAll('.filter-chip').forEach((c) => c.classList.remove('active'));
      btn.classList.add('active');
      const tag = btn.dataset.tag ?? '';

      feed.querySelectorAll<HTMLElement>('.post-slot').forEach((slot) => {
        const tags = (slot.dataset.tags ?? '').split('|');
        slot.classList.toggle('hidden', tag !== '' && !tags.includes(tag));
      });

      // collapse any section (essays, or a notes area) with nothing left in it
      let shown = 0;
      feed.querySelectorAll<HTMLElement>('[data-group]').forEach((group) => {
        const visible = group.querySelectorAll('.post-slot:not(.hidden)').length;
        group.classList.toggle('hidden', visible === 0);
        shown += visible;
      });

      // and the "Notes" wrapper once every area inside it is gone
      const notesBlock = feed.querySelector<HTMLElement>('.notes-block');
      if (notesBlock) {
        const areasLeft = notesBlock.querySelectorAll('[data-group]:not(.hidden)').length;
        notesBlock.classList.toggle('hidden', areasLeft === 0);
      }

      if (empty) empty.hidden = shown > 0;
    });
  }

  document.addEventListener('astro:page-load', initFilter);
</script>
