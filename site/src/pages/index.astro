---
import Base from '../layouts/Base.astro';
import RobotBoard from '../components/RobotBoard.astro';
import ResearchTeasers from '../components/ResearchTeasers.astro';
import PubFigure from '../components/PubFigure.astro';
import { profile } from '../data/profile';
import { publications } from '../data/publications';
import { getPosts, essays, notes } from '../lib/posts';
const posts = await getPosts();
const writing = [...essays(posts), ...notes(posts)].slice(0, 2);
const selected = publications.filter(p => p.selected);
const titles = ['Physics-aware assembly', 'AssemblyComplete', 'Learning from demonstration'];
const descriptions = [
  'Planning robotic assembly, one stable step at a time.',
  'Learning to finish an incomplete structure.',
  'From a human demonstration to a real robot building LEGO.'
];
---
<Base title="Robot learning" description="Alan Chen, a Turing Scholar at UT Austin researching robot learning, mobile manipulation, and multi-agent systems.">
  <section class="hero shell" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="hero-name">Alan Chen</p>
      <h1 id="intro-title">Making<br />robots & myself<br /><span>continually learn.</span></h1>
      <p class="intro">I’m Alan, a Turing Scholar at UT Austin. I'm most interested in LLM/auto-research + RL, robot learning, and representation learning.</p>
      <a class="action" href="#work">Explore the research <span aria-hidden="true">↗</span></a>
    </div>
    <RobotBoard />
  </section>

  <section class="shell section-block" id="work" aria-labelledby="work-title">
    <div class="section-heading"><h2 id="work-title">Current research</h2><a class="quiet-link" href="/research">All research ↗</a></div>
    <ResearchTeasers />
  </section>

  <section class="shell section-block" aria-labelledby="published-title">
    <div class="section-heading"><h2 id="published-title">Selected work</h2><a class="quiet-link" href="/research#publications-title">Publications ↗</a></div>
    <div class="project-list">{selected.map((pub,i) => <article class:list={['project',i===0 && 'project-feature','reveal']}>
      <div class="project-media"><PubFigure pub={pub} /></div>
      <div class="project-copy"><p class="project-venue">{pub.venueShort}</p><h3><a href={`/research#${pub.id}`}>{titles[i]}</a></h3><p>{descriptions[i]}</p><a class="quiet-link" href={`/research#${pub.id}`}>Paper &amp; details ↗</a></div>
    </article>)}</div>
  </section>

  <section class="shell section-block" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">Writing &amp; notes</h2><a class="quiet-link" href="/blog">Open the notebook ↗</a></div>
    <div class="writing-list">
      <a class="writing-row" href="https://developer.arm.com/community/arm-community-blogs/b/ai-blog/posts/evidence-first-harness-engineering-for-million-token-workload-analysis" target="_blank" rel="noopener noreferrer"><div><p>Arm Developer</p><h3>Making sense of a million tokens.</h3></div><span aria-hidden="true">↗</span></a>
      {writing.map(post => <a class="writing-row" href={`/blog/${post.slug}`}><div><p>{post.kind === 'essay' ? 'Essay' : 'Research note'} / {post.minutes} min read</p><h3>{post.title}</h3></div><span aria-hidden="true">↗</span></a>)}
    </div>
  </section>

  <section class="personal shell section-block" aria-labelledby="personal-title">
    <img src="/images/alan-fanuc.jpg" alt="Alan working with a FANUC robot at CMU’s Intelligent Control Lab" loading="lazy" />
    <div><h2 id="personal-title">Outside the lab.</h2><p>Competitive Go, basketball, lifting, and teaching. I started programming at nine, making games on Scratch, and lowkey stopped at 19 when Claude became too good. I still like building things and exploring new hobbies such as fencing.</p><a class="quiet-link" href="/about">More about me ↗</a></div>
  </section>

  <section class="contact shell section-block" id="contact"><div><h2>Let’s talk.</h2><p>Robots, research, or a game of Go.</p></div><a class="action" href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true">↗</span></a></section>
</Base>
<style>
  .shell { width:min(calc(100% - 6rem),80rem); margin-inline:auto; }
  .hero { display:grid; grid-template-columns:.9fr 1.1fr; align-items:center; gap:3rem; padding-top:10rem; padding-bottom:5rem; }
  .hero-name { font-size:1rem; font-weight:600; color:var(--accent); margin-bottom:1.5rem; }
  h1 { font-size:clamp(3.5rem,6.1vw,5.7rem); font-weight:500; line-height:1.04; letter-spacing:-.065em; }
  h1 span { color:var(--accent); }
  .intro { font-size:1.05rem; line-height:1.75; color:var(--muted); max-width:26rem; margin:1.6rem 0 2rem; }
  .action { display:inline-flex; align-items:center; gap:2rem; background:var(--accent); color:var(--bg); padding:.85rem 1.4rem; border-radius:999px; font-size:.9rem; font-weight:600; transition:background .2s,transform .2s; }
  .action:hover { background:var(--accent-strong); transform:translateY(-2px); }.action span { font-size:1.2rem; }
  .section-block { padding-block:3.5rem; }
  .section-heading { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; margin-bottom:2rem; }
  h2 { font-size:clamp(1.9rem,3vw,2.75rem); font-weight:500; letter-spacing:-.05em; line-height:1.15; }
  .quiet-link { display:inline-flex; font-size:.85rem; color:var(--muted); padding:.5rem 0; }.quiet-link:hover { color:var(--accent); }
  .project-list { display:grid; grid-template-columns:1fr 1fr; gap:2.5rem 2rem; }
  .project { min-width:0; }.project-feature { grid-column:1/-1; display:grid; grid-template-columns:3fr 2fr; align-items:center; gap:3rem; }
  .project-media { border-radius:1rem; overflow:hidden; border:1px solid var(--border); background:var(--surface); }
  .project-media :global(figcaption) { display:none; }.project-media :global(figure) { border:0; border-radius:0; margin:0; }.project-media :global(video) { width:100%; }
  .project-copy { padding-block:1.25rem; }.project-copy h3 { font-size:1.65rem; font-weight:500; margin:.75rem 0; letter-spacing:-.04em; }.project-copy h3 a { color:var(--text); }.project-copy h3 a:hover { color:var(--accent); }
  .project-venue { color:var(--accent); font-size:.8rem; }.project-copy > p:not(.project-venue) { color:var(--muted); font-size:.95rem; }.project-copy .quiet-link { margin-top:1rem; }
  .writing-row { display:flex; align-items:center; justify-content:space-between; gap:2rem; border-top:1px solid var(--border); padding:1.6rem 0; color:var(--text); }.writing-row:last-child { border-bottom:1px solid var(--border); }
  .writing-row p { font-size:.75rem; color:var(--muted); margin-bottom:.6rem; }.writing-row h3 { font-size:1.35rem; font-weight:500; letter-spacing:-.03em; }.writing-row > span { font-size:1.5rem; color:var(--accent); }.writing-row:hover h3 { color:var(--accent); }
  .personal { display:grid; grid-template-columns:1fr 1fr; gap:5rem; align-items:center; }.personal img { width:100%; aspect-ratio:1.12; object-fit:cover; border-radius:1rem; }.personal p { color:var(--muted); font-size:1rem; line-height:1.8; margin:1.5rem 0; }
  .contact { display:flex; align-items:center; justify-content:space-between; gap:2rem; padding-block:5rem; }.contact h2 { font-size:clamp(3rem,5vw,4.5rem); }.contact p { margin-top:1rem; color:var(--muted); }
  @media(max-width:1000px) { .shell { width:calc(100% - 4rem); }.hero { gap:1.5rem; }.intro { font-size:.95rem; }.personal { gap:2.5rem; }.project-feature { gap:2rem; } }
  @media(max-width:760px) { .shell { width:calc(100% - 3rem); }.hero { grid-template-columns:1fr; padding-top:8rem; padding-bottom:2rem; gap:2.5rem; }h1 { font-size:clamp(3.5rem,11vw,5rem); }.intro { max-width:30rem; }.hero-name { margin-bottom:1rem; }.section-block { padding-block:2.5rem; }.section-heading { align-items:flex-start; gap:1rem; }h2 { font-size:1.8rem; }.section-heading .quiet-link { text-align:right; font-size:.75rem; flex-shrink:0; }.project-list,.project-feature,.personal { grid-template-columns:1fr; }.project-feature { gap:0; }.project-copy h3 { font-size:1.5rem; }.personal { gap:2rem; }.writing-row h3 { font-size:1.1rem; }.contact { align-items:flex-start; flex-direction:column; }.contact .action { font-size:.8rem; gap:1.5rem; } }
</style>
