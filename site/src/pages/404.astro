---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Page not found.">
  <section class="nf">
    <div class="container nf-inner">
      <svg class="nf-mark" width="72" height="72" viewBox="0 0 72 72" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="70" height="70" rx="14" stroke="currentColor" stroke-opacity="0.25" stroke-width="2" />
        <path d="M24 2v68M48 2v68M2 24h68M2 48h68" stroke="currentColor" stroke-opacity="0.18" stroke-width="2" />
        <circle cx="48" cy="24" r="9" fill="var(--accent)" opacity="0.9" />
        <circle cx="24" cy="48" r="9" fill="currentColor" opacity="0.22" />
      </svg>
      <p class="nf-code">404</p>
      <h1 class="nf-title">Tenuki.</h1>
      <p class="nf-text">This page played elsewhere. The move you're looking for isn't on the board.</p>
      <a class="btn btn-solid" href="/">Back to the opening</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80svh;
    display: flex;
    align-items: center;
  }

  .nf-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.9rem;
  }

  .nf-mark {
    color: var(--text);
    margin-bottom: 0.6rem;
  }

  .nf-code {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.25em;
    font-size: 0.9rem;
  }

  .nf-title {
    font-size: clamp(2.4rem, 7vw, 4rem);
  }

  .nf-text {
    color: var(--muted);
    max-width: 26rem;
  }

  .nf a {
    margin-top: 0.8rem;
  }
</style>
