---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import ResearchTeasers from '../components/ResearchTeasers.astro';
import { publications, scholarUrl } from '../data/publications';
---
<Base title="Research" description="Alan Chen’s current research in robot learning and selected publications.">
  <section class="page-head container"><h1>Research</h1><p class="page-sub">Robot learning, mobile manipulation, and multi-agent systems.</p><a class="btn overview-link" href="/research/overview" data-astro-reload>Private research overview ↗</a></section>
  <section class="container current" aria-labelledby="current-title"><div class="research-heading"><h2 id="current-title">Current projects</h2></div><ResearchTeasers /></section>
  <section class="container published" aria-labelledby="publications-title"><div class="research-heading"><h2 id="publications-title">Publications</h2><a href={scholarUrl} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a></div><div class="pub-list">{publications.map((pub,i) => <PubItem pub={pub} flip={i%2===1} />)}</div></section>
</Base>
<style>
  .page-head { padding-top:9rem; padding-bottom:4rem; }h1 { font-size:clamp(3rem,6vw,5rem); font-weight:400; }h1 em { color:var(--accent); }.page-sub { margin-top:1.2rem; color:var(--muted); max-width:35rem; font-size:.95rem; }
  .overview-link { margin-top:1.5rem; }
  .research-heading { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; margin-bottom:2rem; border-top:1px solid var(--border); padding-top:1.5rem; }.research-heading h2 { font-size:2rem; font-weight:400; }.research-heading span,.research-heading a { font-size:.75rem; color:var(--muted); }.published { padding-block:5rem; }.pub-list { display:flex; flex-direction:column; gap:5rem; padding-top:2rem; }
  @media(max-width:640px) { .research-heading { flex-wrap:wrap; }.page-head { padding-top:7rem; } }
</style>
